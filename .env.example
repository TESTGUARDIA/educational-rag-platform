# Backend Web
JWT_SECRET=CHANGER_MOI
ALLOWED_ORIGINS=http://localhost,http://localhost:80
DB_PATH=/app/data/testguard.db
UPLOADS_DIR=/app/uploads

# Pôle Génération (utilisé par src/generation/)
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://host.docker.internal:11434
NUM_QUESTIONS=5
OLLAMA_NUM_CTX=8192
SECTION_CHAR_SIZE=1800

# Pôle Évaluation (projet-ia, appelé par src/web/back/services.py)
# 1 = charger les modèles de correction/détection dès le démarrage de l'API
# (le premier lancement télécharge ≈ 3 Go de modèles Hugging Face)
PRECHARGER_MODELES=1
